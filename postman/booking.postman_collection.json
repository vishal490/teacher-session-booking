        "url": "{{baseUrl}}/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Duplicate\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"1\"\n}",
          "options": {
